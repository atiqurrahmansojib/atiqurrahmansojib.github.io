---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const marks = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{png,jpg,jpeg,webp}', { eager: true });
const mark = Object.entries(marks).find(([path]) => path.split('/').pop()!.startsWith(`${project.id}.`))?.[1].default;
---
<Base title={data.title} description={data.summary}>
  <article class="wrap project">
    <p class="back"><a href="/#projects"><Icon name="arrow" size={16} /> All projects</a></p>
    <header class="top">
      <div class="headrow">
        <h1 style={`view-transition-name: p-${project.id}`}>{data.title}</h1>
        {mark && <div class="mark"><Image src={mark} alt={`${data.title} logo`} widths={[280, 480]} sizes="14rem" loading="eager" /></div>}
      </div>
      <div class="intro">
        <p class="tagline">{data.tagline}</p>
        <p class="links">
          {data.repo && <a class="btn btn-primary" href={data.repo}><Icon name="github" size={18} /> Source on GitHub</a>}
          {data.live && <a class="btn" href={data.live}>Live demo <Icon name="external" size={18} /></a>}
        </p>
      </div>
    </header>
    <ul class="chips stack" aria-label="Technologies">
      {data.stack.map((s) => <li>{s}</li>)}
    </ul>

    {data.stats.length > 0 && (
      <section class="statbox" data-reveal aria-label="Key figures">
        <dl class="stats">
          {data.stats.map((s, i) => <div data-reveal style={`--i:${i + 1}`}><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
        <p class="src">Figures taken from the project's own README and module list.</p>
      </section>
    )}

    {data.flow.length > 0 && (
      <section class="flow" data-reveal aria-labelledby="flow-title">
        <h2 id="flow-title">How the work flows</h2>
        <p>Hover or focus a step to follow an order through the system.</p>
        <Flow steps={data.flow} label={`${data.title} modules in order`} />
      </section>
    )}

    {data.highlights.length > 0 && (
      <ul class="highlights">
        {data.highlights.map((h, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ul>
    )}

    <div class="body">
      <div class="prose" data-reveal><Content /></div>
      {data.facts.length > 0 && (
        <aside class="facts" data-reveal style="--i:1" aria-label="Project facts">
          <dl>
            {data.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        </aside>
      )}
    </div>

    <nav class="pager" data-reveal aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}><span>Previous</span><strong>{prev.data.title}</strong></a> : <span></span>}
      {next ? <a class="next" href={`/projects/${next.id}/`}><span>Next</span><strong>{next.data.title}</strong></a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .project { padding-block: 7.5rem 6rem; }
  .back a { display: inline-flex; align-items: center; gap: 0.5rem; padding-block: 0.6rem; text-decoration: none; color: var(--muted); }
  .back a :global(svg) { transform: scaleX(-1); }
  .back a:hover { color: var(--text); }
  .top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.6rem clamp(1rem, 3vw, 3rem); margin-top: 1rem; align-items: end; }
  .headrow { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.2rem 2rem; }
  .mark { flex: none; width: clamp(9rem, 6rem + 9vw, 15rem); padding: 0.6rem; border-radius: 1.1rem; background: #fff; box-shadow: 0 1rem 2.4rem -1rem rgba(0, 0, 0, 0.6); animation: settle 0.9s var(--ease) 0.3s both; }
  .mark :global(img) { display: block; width: 100%; height: auto; border-radius: 0.7rem; }
  h1 { grid-column: 1 / -1; font-size: clamp(2.8rem, 1rem + 6.6vw, 6.4rem); font-weight: 800; font-stretch: 75%; letter-spacing: -0.05em; line-height: 0.82; }
  .intro { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 3rem; padding-top: 1.4rem; border-top: 1px solid var(--line-strong); }
  .tagline { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; max-width: 24ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .stack { margin-top: 1.6rem; }
  .intro, .stack { animation: settle 0.9s var(--ease) 0.25s both; }
  .stack { animation-delay: 0.4s; }
  @keyframes settle { from { opacity: 0; transform: translateY(1.2rem); } }

  .statbox { margin-top: clamp(3rem, 6vw, 5rem); padding-block: 2rem; border-block: 1px solid var(--line-strong); }
  .stats { display: flex; flex-wrap: wrap; gap: 2rem 5rem; }
  .stats div { display: flex; flex-direction: column-reverse; max-width: 15rem; }
  .stats dd { font-family: var(--font-display); font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem); font-weight: 800; letter-spacing: -0.045em; line-height: 0.9; }
  .stats dt { color: var(--muted); font-size: var(--step--1); margin-top: 0.5rem; line-height: 1.35; }
  .src { margin-top: 1.4rem; color: var(--muted); font-size: var(--step--1); }

  .flow { margin-top: clamp(3rem, 6vw, 5rem); max-width: 56rem; }
  .flow h2 { font-size: var(--step-2); margin-bottom: 0.7rem; }
  .flow p { color: var(--muted); margin-bottom: 1.4rem; }

  .highlights { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--line-strong); }
  .highlights li { padding: 1.6rem 1.6rem 1.8rem 0; border-bottom: 1px solid var(--line); }
  .highlights h3 { font-size: var(--step-1); line-height: 1.2; }
  .highlights p { color: var(--muted); margin-top: 0.6rem; }

  .body { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); margin-top: clamp(3rem, 6vw, 5rem); align-items: start; }
  .facts { position: sticky; top: 6.5rem; border-top: 1px solid var(--line-strong); }
  .facts div { padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: var(--step--1); color: var(--muted); }
  .facts dd { font-weight: 600; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 6rem; border-top: 1px solid var(--line-strong); }
  .pager a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.5rem 0; text-decoration: none; color: var(--text); }
  .pager a:hover strong { color: var(--accent); }
  .pager span { font-size: var(--step--1); color: var(--muted); }
  .pager strong { font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; letter-spacing: -0.03em; }
  .next { text-align: right; }
  @media (max-width: 52rem) { .body { grid-template-columns: 1fr; } .facts { position: static; } .pager { grid-template-columns: 1fr; } .next { text-align: left; } }
</style>
