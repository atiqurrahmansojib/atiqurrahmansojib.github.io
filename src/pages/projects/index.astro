---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="All projects by Atiqur Rahman: RMGFlow and Tanabana.">
  <section class="wrap page">
    <h1 class="section-title">All projects</h1>
    <p class="lede">Every project here links to its public source code.</p>
    <div class="cases">
      {all.map((p, i) => <CaseStudy level={2} project={p} n={i} />)}
    </div>
  </section>
</Base>

<style>
  .page { padding-block: 8rem 6rem; }
  h1 { font-size: clamp(2.8rem, 1rem + 6vw, 5.8rem); }
  .lede { margin: 1rem 0 clamp(2rem, 4vw, 4rem); }
</style>
