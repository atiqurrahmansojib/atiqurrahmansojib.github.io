---
import * as icons from 'simple-icons';
import { skills } from '../data/site';

// Brands whose official colour is near-black are drawn in the text colour so they stay visible on dark.
const dark = new Set(['0F0F11', '181717', '000000']);
// No Oracle mark exists in simple-icons, so a plain database glyph (stroke) stands in for it.
const DB = 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zm8 3v12c0 1.7-3.6 3-8 3s-8-1.3-8-3V6m16 6c0 1.7-3.6 3-8 3s-8-1.3-8-3';
const tiles = skills.map((s) => {
  if (s.icon === 'custom-db') return { ...s, path: DB, color: 'var(--accent)', stroke: true };
  const ic = (icons as Record<string, { path: string; hex: string }>)[s.icon];
  return { ...s, path: ic.path, color: dark.has(ic.hex.toUpperCase()) ? 'var(--text)' : `#${ic.hex}`, stroke: false };
});
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="wrap split">
    <div class="head">
      <p class="eyebrow">Tech stack</p>
      <h2 id="skills-title">My Skills</h2>
      <p>Technologies from my projects and my IsDB-BISEW training. Hover or focus a tile to see where.</p>
    </div>
    <ul class="tiles">
      {tiles.map((t) => {
        const id = `used-${t.name}`.replace(/\W+/g, '-');
        return (
          <li class="tile" tabindex="0" aria-describedby={id}>
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false" style={t.stroke ? `fill:none;stroke:${t.color};stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round` : `fill:${t.color}`}><path d={t.path} /></svg>
            <span class="name">{t.name}</span>
            <span class="used" role="tooltip" id={id}>Used in {t.used.join(', ')}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 2rem 3rem; align-items: start; }
  h2 { font-size: var(--step-3); }
  .head p:last-child { margin-top: 0.8rem; color: var(--muted); font-size: 0.92rem; max-width: 26ch; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.8rem, 1fr)); gap: 0.8rem; }
  .tile { position: relative; border: 1px solid var(--line); border-radius: 0.8rem; background: color-mix(in srgb, var(--surface) 55%, transparent); transition: border-color 0.25s, background 0.25s, transform 0.3s var(--ease); }
  .tile:hover, .tile:focus-visible { border-color: var(--accent); background: var(--glow-soft); transform: translateY(-2px); }
  .tile { overflow: visible; display: grid; justify-items: center; align-content: center; gap: 0.55rem; min-height: 5.6rem; padding: 0.9rem 0.4rem; text-align: center; cursor: default; }
  .name { font-size: 0.78rem; font-weight: 600; }
  .used { position: absolute; left: 50%; bottom: calc(100% + 0.5rem); z-index: 5; width: max-content; max-width: 14rem; padding: 0.4rem 0.7rem; border-radius: 0.5rem; background: var(--surface-2); border: 1px solid var(--line-strong); font-size: 0.75rem; box-shadow: var(--shadow); opacity: 0; transform: translate(calc(-50% + var(--dx, 0px)), 4px); pointer-events: none; transition: opacity 0.2s, transform 0.25s var(--ease); }
  .tile:hover .used, .tile:focus .used, .tile:focus-within .used { opacity: 1; transform: translate(calc(-50% + var(--dx, 0px)), 0); }
  @media (max-width: 52rem) { .split { grid-template-columns: 1fr; } .head p:last-child { max-width: none; } }
</style>
