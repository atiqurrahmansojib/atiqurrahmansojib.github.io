---
import { training } from '../data/site';
import Icon from './Icon.astro';
---
<section id="experience" class="section wrap" aria-labelledby="exp-title">
  <h2 id="exp-title" class="section-title" data-reveal>Training</h2>
  <article class="course" data-reveal style="--i:1" aria-labelledby="train-title">
    <div class="meta">
      <p class="org">{training.programme}</p>
      <p class="done">Completed</p>
      <p class="dur">{training.duration}, {training.track}</p>
      <a class="btn" href={training.url}>Official course details <Icon name="external" size={16} /></a>
    </div>
    <div class="content">
      <h3 id="train-title">{training.course}</h3>
      <p class="covers-label">Official course modules, {training.duration} in total</p>
      <ol class="modules" data-line>
        {training.modules.map((m, i) => <li data-reveal style={`--i:${i % 3}`}>{m}</li>)}
      </ol>
      <p class="covers-label">Technologies covered</p>
      <ul class="chips badges" aria-label="Technologies covered by the course">
        {training.covers.map((t) => <li class="badge">{t}</li>)}
      </ul>
    </div>
  </article>
</section>

<style>
  .course { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem clamp(1rem, 3vw, 3rem); margin-top: clamp(2rem, 4vw, 3.5rem); padding-top: 2rem; border-top: 1px solid var(--line-strong); }
  .meta { grid-column: 1 / span 4; display: grid; gap: 0.5rem; align-content: start; justify-items: start; }
  .content { grid-column: 5 / -1; }
  .org { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; }
  .done { padding: 0.15rem 0.8rem; border-radius: 999px; background: var(--accent-strong); color: var(--on-accent); font-size: 0.78rem; font-weight: 700; }
  .dur { color: var(--muted); font-size: var(--step--1); margin-bottom: 0.8rem; }
  h3 { font-size: clamp(1.4rem, 1.1rem + 1.1vw, 2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; max-width: 24ch; }
  .covers-label { margin-top: 2rem; margin-bottom: 0.7rem; font-size: var(--step--1); font-weight: 600; color: var(--muted); }
  /* The modules are a real sequence, so they sit on a numbered line that fills as it scrolls into view. */
  .modules { position: relative; counter-reset: m; display: grid; padding-left: 2.8rem; max-width: 54ch; }
  .modules::before, .modules::after { content: ''; position: absolute; left: 0.9rem; top: 1rem; bottom: 1rem; width: 2px; }
  .modules::before { background: var(--line-strong); }
  .modules::after { background: var(--accent); transform-origin: top; transform: scaleY(var(--p, 0)); }
  .modules li { position: relative; counter-increment: m; padding-block: 0.7rem; }
  .modules li::before { content: counter(m); position: absolute; left: -2.8rem; top: 0.6rem; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--bg); border: 2px solid var(--line-strong); color: var(--muted); font-size: 0.78rem; font-weight: 800; font-variant-numeric: tabular-nums; transition: border-color 0.4s, color 0.4s, background 0.4s; }
  .modules li[data-in]::before { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 62rem) { .meta, .content { grid-column: 1 / -1; } }
</style>
