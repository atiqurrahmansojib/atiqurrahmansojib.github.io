---
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { site } from '../data/site';
---
<section id="contact" class="section wrap" aria-labelledby="contact-title">
  <div class="panel">
    <div class="intro">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Let's work together</h2>
      <p class="sub">Reach me through any of the links here.</p>
    </div>
    <ul class="ways">
      <li>
        <span class="ico"><Icon name="mail" size={20} /></span>
        <div><p class="lab">Email</p><p class="val">{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <Placeholder>public email address</Placeholder>}</p></div>
      </li>
      <li>
        <span class="ico"><Icon name="linkedin" size={20} /></span>
        <div><p class="lab">LinkedIn</p><p class="val">{site.linkedin ? <a href={site.linkedin}>Profile</a> : <Placeholder>LinkedIn link, if wanted</Placeholder>}</p></div>
      </li>
      <li>
        <span class="ico"><Icon name="github" size={20} /></span>
        <div><p class="lab">GitHub</p><p class="val"><a href={site.github}>{site.githubHandle}</a></p></div>
      </li>
    </ul>
    {site.email
      ? <a class="btn" href={`mailto:${site.email}`}>Send message <Icon name="send" size={16} /></a>
      : <span class="btn" role="link" aria-disabled="true">Send message <Icon name="send" size={16} /></span>}
  </div>
</section>

<style>
  .panel { border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(120deg, color-mix(in srgb, var(--accent-strong) 14%, transparent), transparent 60%); display: grid; grid-template-columns: 1.2fr 2.4fr auto; gap: 2rem; align-items: center; padding: 2rem clamp(1.4rem, 3vw, 2.4rem); }
  h2 { font-size: var(--step-2); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .sub { color: var(--muted); font-size: 0.9rem; margin-top: 0.4rem; max-width: 30ch; }
  .ways { display: flex; flex-wrap: wrap; gap: 1.2rem 2.2rem; }
  .ways li { display: flex; align-items: center; gap: 0.9rem; }
  .ico { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--muted); }
  .lab { font-weight: 600; font-size: 0.85rem; }
  .val { color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 62rem) { .panel { grid-template-columns: 1fr; } }
</style>
