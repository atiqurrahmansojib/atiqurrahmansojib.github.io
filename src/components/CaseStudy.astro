---
import type { CollectionEntry } from 'astro:content';
import Flow from './Flow.astro';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; level?: 2 | 3; flip?: boolean; compact?: boolean }
const { project, level = 3, flip = false, compact = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const { data, id } = project;
---
<article class:list={['case', { flip, compact }]}>
  <Heading class="title"><a class="stretch" href={`/projects/${id}/`}>{data.title}</a></Heading>
  <div class="story">
    <p class="lead">{data.tagline}</p>
    <p class="summary">{data.summary}</p>
    <p class="go">
      <span class="more">Read the case study <Icon name="arrow" size={16} /></span>
      {data.repo && <a class="src" href={data.repo} aria-label={`${data.title} source on GitHub`}><Icon name="github" size={17} /> Source on GitHub</a>}
      {data.live && <a class="src" href={data.live} aria-label={`${data.title} live demo`}>Live demo <Icon name="external" size={15} /></a>}
    </p>
  </div>
  <div class="evidence">
    {!compact && data.stats.length > 0 && (
      <dl class="stats">
        {data.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
      </dl>
    )}
    {!compact && data.flow.length > 0 && <Flow steps={data.flow} label={`${data.title} modules in order`} />}
    <ul class="chips" aria-label={`${data.title} technologies`}>
      {data.stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</article>

<style>
  .case { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.6rem clamp(1rem, 3vw, 3rem); padding-block: clamp(2.4rem, 5vw, 4.5rem); border-top: 1px solid var(--line-strong); }
  .title { grid-column: 1 / -1; font-size: clamp(3.4rem, 1rem + 11vw, 10rem); font-weight: 800; font-stretch: 75%; letter-spacing: -0.045em; line-height: 0.85; }
  .stretch { color: var(--text); text-decoration: none; transition: color 0.3s; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .case:hover .stretch { color: var(--accent); }
  .story { grid-column: 1 / span 5; align-self: start; }
  .evidence { grid-column: 6 / -1; display: grid; gap: 1.6rem; align-content: start; }
  .flip .story { grid-column: 8 / -1; grid-row: 2; }
  .flip .evidence { grid-column: 1 / span 7; grid-row: 2; }
  .lead { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; }
  .summary { margin-top: 0.9rem; color: var(--muted); max-width: 44ch; }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 1.4rem; margin-top: 1.4rem; font-weight: 600; font-size: 0.92rem; }
  .more { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text); transition: gap 0.3s var(--ease), color 0.3s; }
  .case:hover .more { gap: 0.9rem; color: var(--accent); }
  .src { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.75rem; color: var(--muted); text-decoration: none; }
  .src:hover { color: var(--text); text-decoration: underline; }
  .stats { display: flex; flex-wrap: wrap; gap: 1.2rem 3rem; }
  .stats div { display: flex; flex-direction: column-reverse; max-width: 12rem; }
  .stats dd { font-family: var(--font-display); font-size: clamp(2.6rem, 2rem + 2.5vw, 4.4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; }
  .stats dt { margin-top: 0.4rem; color: var(--muted); font-size: var(--step--1); line-height: 1.35; }
  .chips { align-self: end; }

  .compact { padding-block: 1.8rem; }
  .compact .title { font-size: clamp(2rem, 1.4rem + 3vw, 3.6rem); line-height: 0.95; grid-column: 1 / span 5; align-self: center; }
  .compact .story { grid-column: 6 / span 4; }
  .compact .evidence { grid-column: 10 / -1; }
  .compact .summary { display: none; }
  .compact .go { margin-top: 0.8rem; }

  @media (max-width: 62rem) {
    .story, .flip .story { grid-column: 1 / -1; grid-row: auto; }
    .evidence, .flip .evidence { grid-column: 1 / -1; grid-row: auto; }
    .compact .title, .compact .story, .compact .evidence { grid-column: 1 / -1; }
  }
</style>
