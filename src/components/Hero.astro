---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Icon from './Icon.astro';

// Real photo: drop a file named profile.jpg, .jpeg, .png or .webp into src/assets/.
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile.{jpg,jpeg,png,webp}', { eager: true }),
)[0];
const photo = found?.default;
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="portrait">
    {photo
      ? <Image src={photo} alt={`Portrait of ${site.name}`} widths={[420, 640, 900]} sizes="(max-width: 52rem) 100vw, 50vw" loading="eager" fetchpriority="high" />
      : <div class="empty"><span class="placeholder">profile photo not provided</span></div>}
  </div>
  <div class="wrap inner">
    <h1 id="hero-title"><span class="line"><span class="word">{site.first}</span></span><span class="line"><span class="word">{site.last}</span></span></h1>
    <div class="lower">
      <div class="said">
        <p class="role">{site.role}</p>
        <p class="tag">{site.tagline}</p>
      </div>
      <div class="acts">
        <a class="btn btn-primary" href="#projects">See the work <Icon name="arrow" size={18} /></a>
        <a class="btn" href="#contact">Get in touch</a>
        <ul class="social" aria-label="Social links">
          <li><a href={site.github} aria-label="GitHub"><Icon name="github" size={22} /></a></li>
          {site.linkedin && <li><a href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={22} /></a></li>}
          {site.facebook && <li><a href={site.facebook} aria-label="Facebook"><Icon name="facebook" size={22} /></a></li>}
          {site.instagram && <li><a href={site.instagram} aria-label="Instagram"><Icon name="instagram" size={22} /></a></li>}
          {site.email && <li><a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={22} /></a></li>}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: max(36rem, 100svh); display: flex; align-items: flex-end; border-bottom: 1px solid var(--line); overflow: clip; padding-top: 5rem; }
  .glow { position: absolute; right: -8%; top: 4%; width: min(70vw, 60rem); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, var(--glow-soft), transparent 65%); pointer-events: none; }
  .portrait { position: absolute; right: clamp(0rem, 4vw, 5rem); bottom: 0; width: min(52vw, 46rem, 98svh); aspect-ratio: 1; }
  .portrait { -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent); mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; display: block; }
  .empty { height: 100%; display: grid; place-items: end center; padding-bottom: 20%; }

  .inner { position: relative; z-index: 2; padding-bottom: clamp(1.8rem, 4vh, 3.5rem); }
  h1 { font-size: var(--step-hero); font-weight: 800; font-stretch: 75%; letter-spacing: -0.045em; line-height: 0.8; margin-left: -0.04em; }
  .line { display: block; overflow: hidden; padding-block: 0.06em 0.1em; }
  .word { display: block; }
  .lower { display: grid; gap: 1.4rem; max-width: 40rem; margin-top: clamp(1.2rem, 3vh, 2.4rem); padding-top: 1.4rem; border-top: 1px solid var(--line-strong); }
  .role { font-family: var(--font-display); font-size: clamp(1.7rem, 1.1rem + 2.2vw, 3.2rem); font-weight: 700; font-stretch: 85%; line-height: 1; letter-spacing: -0.035em; }
  .tag { margin-top: 0.7rem; font-size: var(--step-1); font-weight: 500; line-height: 1.3; max-width: 30ch; color: var(--text); }
  .acts { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; }
  .social { display: flex; gap: 0.2rem; margin-left: 0.4rem; }
  .social a { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; color: var(--muted); }
  .social a:hover { color: var(--text); }

  /* One entrance: the name rises line by line, then the portrait and the rest settle in. */
  .word { animation: rise 1.1s var(--ease) both; }
  .line:nth-child(2) .word { animation-delay: 0.12s; }
  .portrait { animation: settle 1.4s var(--ease) 0.25s both; }
  .lower { animation: settle 1s var(--ease) 0.7s both; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .portrait :global(img) { animation: drift linear both; animation-timeline: scroll(root block); animation-range: 0 90vh; }
      @keyframes drift { to { transform: translateY(6%) scale(1.05); } }
    }
  }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes settle { from { opacity: 0; transform: translateY(2rem); } }

  @media (max-width: 52rem) {
    .hero { align-items: flex-end; min-height: 100svh; }
    .portrait { width: 112vw; right: -6vw; bottom: auto; top: 4.2rem; }
    .portrait { -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent); mask-image: linear-gradient(180deg, #000 70%, transparent); }
    .inner { padding-top: calc(112vw - 1.5rem); }
    h1 { font-size: clamp(4.2rem, 24vw, 9rem); }
  }
</style>
