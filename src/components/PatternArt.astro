---
// A garment pattern piece (bodice front), drawn like a tailor's pattern: cut line, stitched seam,
// grain line, notches and a waist mark. With `marked`, five segments can be highlighted by the
// hero's hotspots, and the cut line and seam draw themselves once on load.
interface Props { marked?: boolean }
const { marked = false } = Astro.props;
const cut = 'M130 36 C150 80 210 80 230 36 L296 62 C286 118 298 158 320 184 L316 400 L44 400 L40 184 C62 158 74 118 64 62 Z';
---
<svg class:list={['pattern', { marked }]} viewBox="0 0 360 440" aria-hidden="true" focusable="false">
  {marked && (
    <defs>
      <mask id="seam-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="360" height="440">
        <path d={cut} pathLength="1" class="reveal-stroke" fill="none" stroke="#fff" stroke-width="60" />
      </mask>
    </defs>
  )}
  <path d={cut} class="cut" pathLength="1" />
  <g mask={marked ? 'url(#seam-reveal)' : undefined}>
    <path d={cut} class="seam" transform="translate(180 220) scale(0.93) translate(-180 -220)" />
  </g>
  <path class="waist" d="M42 280 H318" />
  <path class="grain" d="M180 120 V360 M172 134 L180 120 L188 134 M172 346 L180 360 L188 346" />
  <path class="notch" d="M40 184 h13 M320 184 h-13 M180 400 v-11 M174 400 v-8 M186 400 v-8 M64 62 l8 8 M296 62 l-8 8" />
  {marked && (
    <g class="segs" fill="none">
      <path class="seg s-neck" d="M130 36 C150 80 210 80 230 36" />
      <path class="seg s-shoulder" d="M230 36 L296 62 C286 118 298 158 320 184" />
      <path class="seg s-armhole" d="M40 184 C62 158 74 118 64 62" />
      <path class="seg s-waist" d="M42 280 H318" />
      <path class="seg s-hem" d="M44 400 L316 400" />
    </g>
  )}
</svg>

<style>
  .pattern { width: 100%; height: auto; overflow: visible; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .cut { stroke: var(--text); stroke-width: 1.6; opacity: 0.8; }
  .seam { stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 6 6; vector-effect: non-scaling-stroke; }
  .waist { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 14 4 2 4; opacity: 0.7; }
  .grain, .notch { stroke: var(--muted); stroke-width: 1.4; }
  .seg { stroke: var(--accent); stroke-width: 4; opacity: 0; filter: drop-shadow(0 0 6px var(--glow)); transition: opacity 0.25s; }

  .marked .cut { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.7s var(--ease) 0.25s forwards; }
  .marked .reveal-stroke { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 2.2s var(--ease) 0.7s forwards; }
  .marked .grain, .marked .notch, .marked .waist { opacity: 0; animation: fade 0.8s ease 2.2s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 0.9; } }
  @media (prefers-reduced-motion: reduce) {
    .marked .cut, .marked .reveal-stroke { stroke-dashoffset: 0; }
    .marked .grain, .marked .notch, .marked .waist { opacity: 0.9; }
  }
</style>
