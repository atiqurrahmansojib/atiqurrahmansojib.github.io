---
// Interactive pipeline built from a project's real, ordered module list.
interface Props { steps: string[]; label: string }
const { steps, label } = Astro.props;
---
<div class="flow" data-flow>
  <ol aria-label={label}>
    {steps.map((s, i) => <li data-step tabindex="0"><span class="n" aria-hidden="true">{i + 1}</span>{s}</li>)}
  </ol>
</div>

<style>
  ol { display: flex; flex-wrap: wrap; gap: 0.4rem 0.5rem; }
  li {
    position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.25rem 0.8rem 0.25rem 0.3rem;
    border: 1px solid var(--line-strong); border-radius: 999px; font-weight: 600; font-size: var(--step--1);
    color: var(--muted); cursor: default; transition: color 0.25s, border-color 0.25s, background 0.25s;
  }
  .n { display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 1px solid var(--line-strong); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
  li[data-lit] { color: var(--text); border-color: var(--accent); background: var(--glow-soft); }
  li[data-lit] .n { background: var(--accent-strong); border-color: var(--accent-strong); color: var(--on-accent); }
</style>
