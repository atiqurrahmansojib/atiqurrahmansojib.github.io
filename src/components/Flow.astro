---
// Interactive pipeline built from a project's real, ordered module list.
interface Props { steps: string[]; label: string }
const { steps, label } = Astro.props;
---
<div class="flow" data-flow>
  <ol aria-label={label}>
    {steps.map((s, i) => <li data-step tabindex="0"><span class="n" aria-hidden="true">{i + 1}</span>{s}</li>)}
  </ol>
</div>

<style>
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; counter-reset: s; }
  li {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.9rem 0.4rem 0.45rem;
    border: 1px solid var(--line-strong); border-radius: 999px; font-weight: 600; font-size: var(--step--1);
    background: var(--glow-soft); color: var(--muted); cursor: default;
    transition: color 0.25s, border-color 0.25s, background 0.25s, box-shadow 0.35s, transform 0.35s var(--ease);
  }
  .n { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: 50%; background: var(--surface); font-size: 0.72rem; color: var(--accent); }
  li[data-lit] { color: var(--text); border-color: var(--accent); background: color-mix(in srgb, var(--accent-strong) 28%, transparent); box-shadow: 0 0 22px -4px var(--glow); }
  li[data-lit] .n { background: var(--accent-strong); color: var(--on-accent); }
  li:focus-visible { transform: translateY(-2px); }
</style>
