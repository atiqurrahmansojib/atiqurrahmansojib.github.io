---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.slice(0, 3);
---
<section id="projects" class="section band" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Featured projects</p>
        <h2 id="projects-title">My Work</h2>
      </div>
      <p class="blurb">Real projects. Practical solutions.<br />Built with Java, Spring Boot, Flutter and Angular.</p>
      <a class="all" href="/projects/">View all projects <Icon name="arrow" size={15} /></a>
    </div>
    <div class="grid">
      {featured.map((p, i) => (
        <ProjectCard project={p} variant={i === 0 ? 'feature' : 'compact'} badge={i === 0 ? 'Flagship project' : undefined} selected={i === 0} />
      ))}
    </div>
  </div>
</section>

<style>
  .band { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bg-2) 70%, transparent)); }
  .head { display: grid; grid-template-columns: 1fr auto auto; gap: 1.5rem 3rem; align-items: end; margin-bottom: 2.2rem; }
  h2 { font-size: var(--step-3); }
  .blurb { color: var(--muted); font-size: 0.9rem; line-height: 1.5; text-align: left; }
  .all { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; font-weight: 600; text-decoration: none; padding-block: 0.8rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 1.3rem; align-items: stretch; }
  .grid > :global(:first-child) { grid-row: span 2; }
  @media (max-width: 62rem) { .head { grid-template-columns: 1fr; } }
  @media (max-width: 52rem) { .grid { grid-template-columns: 1fr; } .grid > :global(:first-child) { grid-row: auto; } }
</style>
