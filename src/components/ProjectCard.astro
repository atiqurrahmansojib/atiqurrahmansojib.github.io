---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; badge?: string; selected?: boolean; level?: 2 | 3; variant?: 'default' | 'feature' | 'compact' }
const { project, badge, selected = false, level = 3, variant = 'default' } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const { data, id } = project;

// Optional screenshot: add src/assets/projects/<slug>.png (or .jpg/.webp). Without one, a monogram cover shows.
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{png,jpg,jpeg,webp}', { eager: true });
const shot = Object.entries(shots).find(([path]) => path.split('/').pop()!.startsWith(`${id}.`))?.[1].default;
---
<article class:list={['card', 'glow-card', variant, { selected }]}>
  <div class="cover">
    {shot
      ? <Image src={shot} alt={`${data.title} screenshot`} widths={[400, 700]} sizes="(max-width: 52rem) 90vw, 24rem" loading="lazy" />
      : <div class="ph"><span class="mono" aria-hidden="true">{data.title.slice(0, 2)}</span></div>}
    {badge && <span class="pill">{badge}</span>}
  </div>
  <div class="body">
    <Heading><a class="stretch" href={`/projects/${id}/`}>{data.title}</a>
      {data.live && <Icon name="external" size={15} />}
    </Heading>
    <p class="desc">{data.summary}</p>
    {variant === 'feature' && data.stats.length > 0 && (
      <dl class="stats">
        {data.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
      </dl>
    )}
    <ul class="tags" aria-label={`${data.title} technologies`}>
      {data.stack.slice(0, 5).map((s) => <li>{s}</li>)}
    </ul>
    <div class="foot">
      <span class="more">View details <Icon name="arrow" size={15} /></span>
      <span class="links">
        {data.repo && <a href={data.repo} aria-label={`${data.title} on GitHub`}><Icon name="github" size={17} /> GitHub</a>}
        {data.live && <a href={data.live} aria-label={`${data.title} live demo`}>Live <Icon name="external" size={15} /></a>}
      </span>
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; height: 100%; padding: 0; }
  .card.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 40px -8px var(--glow); }
  .cover { position: relative; aspect-ratio: 16 / 9; flex: none; background: linear-gradient(135deg, #14245a, #0b1330 70%); overflow: hidden; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph { height: 100%; display: grid; place-items: center; align-content: center; gap: 0.6rem; background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--accent-strong) 45%, transparent), transparent 60%); }
  .mono { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.04em; color: #fff; opacity: 0.9; }
  .pill { position: absolute; top: 0.8rem; left: 0.8rem; padding: 0.25rem 0.75rem; border-radius: 0.5rem; background: color-mix(in srgb, var(--accent-strong) 85%, #000); color: #fff; font-size: 0.75rem; font-weight: 700; }
  .body { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.2rem 1.3rem 1.3rem; flex: 1; }
  .body > :global(h2), .body > :global(h3) { display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; font-family: var(--font-body); }
  .stretch { color: var(--text); text-decoration: none; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .desc { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { padding: 0.15rem 0.6rem; border-radius: 0.4rem; background: var(--glow-soft); border: 1px solid var(--line); font-size: 0.75rem; font-weight: 600; color: var(--accent); }
  .foot { margin-top: auto; padding-top: 0.8rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; font-weight: 600; }
  .more { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--accent); transition: gap 0.3s var(--ease); }
  .card:hover .more { gap: 0.8rem; }
  .links { position: relative; z-index: 2; display: flex; gap: 0.2rem; }
  .links a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding-inline: 0.6rem; border-radius: 0.5rem; color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--text); background: var(--glow-soft); }
  .feature .cover { aspect-ratio: 16 / 8; }
  .feature h2, .feature h3 { font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem); letter-spacing: -0.03em; }
  .feature .desc { font-size: 1.02rem; max-width: 48ch; }
  .feature .body { padding: 1.6rem 1.8rem 1.8rem; gap: 1rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 1rem 2.4rem; margin: 0.4rem 0; }
  .stats div { display: flex; flex-direction: column-reverse; max-width: 11rem; }
  .stats dd { margin: 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .stats dt { font-size: 0.78rem; color: var(--muted); margin-top: 0.25rem; }
  .compact { flex-direction: row; }
  .compact .cover { width: 34%; aspect-ratio: auto; min-height: 100%; }
  .compact .mono { font-size: 1.8rem; }
  .compact .pill { display: none; }
  @media (max-width: 40rem) { .compact { flex-direction: column; } .compact .cover { width: 100%; aspect-ratio: 16 / 7; min-height: 0; } }
</style>
