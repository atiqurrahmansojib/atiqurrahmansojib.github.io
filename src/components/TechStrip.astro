---
import * as icons from 'simple-icons';
import { skills } from '../data/site';
// The technologies behind both flagship projects, taken from the skills data.
const names = ['Java', 'Spring Boot', 'Angular', 'Flutter', 'PostgreSQL', 'Docker'];
const dark = new Set(['0F0F11', '181717', '000000']);
const items = names.map((n) => {
  const s = skills.find((k) => k.name === n)!;
  const ic = (icons as Record<string, { path: string; hex: string }>)[s.icon];
  return { name: n, path: ic.path, color: dark.has(ic.hex.toUpperCase()) ? 'var(--text)' : `#${ic.hex}` };
});
---
<div class="strip" role="group" aria-label="Core technologies">
  <ul class="wrap">
    {items.map((t, i) => (
      <li style={`--i:${i}`}>
        <a href="#skills">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" style={`fill:${t.color}`}><path d={t.path} /></svg>
          <span>{t.name}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .strip { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 55%, transparent); backdrop-filter: blur(6px); }
  @media (max-width: 62rem), (hover: none) { .strip { background: var(--bg-2); backdrop-filter: none; } }
  ul { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1.5rem; padding-block: 0.6rem; }
  li { animation: strip-in 0.8s var(--ease) calc(1.1s + var(--i) * 0.07s) both; }
  a { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; padding-inline: 0.2rem; color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.92rem; transition: color 0.25s, transform 0.35s var(--ease); }
  a svg { transition: transform 0.35s var(--ease); }
  a:hover { color: var(--text); transform: translateY(-2px); }
  a:hover svg { transform: scale(1.18) rotate(-4deg); }
  @keyframes strip-in { from { opacity: 0; transform: translateY(0.8rem); } }
  @media (max-width: 40rem) { ul { justify-content: flex-start; gap: 0 1.2rem; } }
</style>
