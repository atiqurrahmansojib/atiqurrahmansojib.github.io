---
import Placeholder from './Placeholder.astro';
import Icon from './Icon.astro';
import PatternArt from './PatternArt.astro';
import { site, training, education, languages } from '../data/site';
const facts = [
  { icon: 'pin', label: 'Location', value: site.location, ph: 'location' },
  { icon: 'cap', label: 'Education and training', value: 'scholarship', ph: '' },
  { icon: 'globe', label: 'Languages', value: languages, ph: 'languages spoken' },
] as const;
---
<section id="about" class="section band" aria-labelledby="about-title">
  <div class="wrap split">
    <div class="text">
      <p class="eyebrow">About me</p>
      <h2 id="about-title">A little about me</h2>
      <p class="p">I am a software developer in {site.location}, building business software with Java, Spring Boot and Flutter. I hold a B.Sc. and an M.Sc. in Physics from the University of Rajshahi.</p>
      <p class="p">I completed the {training.programme} course in {training.course.replace(' using ', ' with ')} ({training.duration}), covering Java, Oracle, UML, Hibernate, Angular, Spring Boot, Android and Flutter. I apply that stack to software for the garment industry: RMGFlow, a Spring Boot and Flutter platform for buying houses, and Tanabana, an Angular and Spring Boot ERP for garment groups.</p>
    </div>
    <ul class="facts">
      {facts.map((f) => (
        <li>
          <span class="ico"><Icon name={f.icon} size={18} /></span>
          <div>
            <p class="lab">{f.label}</p>
            {f.value === 'scholarship'
              ? <p class="val"><a href="#experience">{training.programme}</a>: course completed, {training.track}. </p>
                <ul class="edu">{education.map((e) => <li>{e.degree} ({e.year}), {e.school}</li>)}</ul>
              : <p class="val">{f.value ?? <Placeholder>{f.ph}</Placeholder>}</p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="art" aria-hidden="true">
      <PatternArt />
    </div>
  </div>
</section>

<style>
  .band { background: linear-gradient(180deg, color-mix(in srgb, var(--bg-2) 70%, transparent), transparent); }
  .split { display: grid; grid-template-columns: 1.1fr 1fr 0.9fr; gap: 2rem 3rem; align-items: center; }
  h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .p { color: var(--muted); font-size: 0.95rem; line-height: 1.7; max-width: 40ch; }
  .p + .p { margin-top: 0.9rem; }
  .edu { margin-top: 0.4rem; color: var(--muted); font-size: 0.9rem; }
  .val a { color: var(--accent); }
  .facts { display: grid; gap: 1rem; }
  .facts li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .ico { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 0.6rem; border: 1px solid var(--line-strong); color: var(--muted); }
  .lab { font-weight: 600; font-size: 0.9rem; }
  .val { color: var(--muted); font-size: 0.85rem; }
  .art { padding: 1.5rem 3.5rem; border: 1px dashed var(--line-strong); border-radius: var(--radius); display: grid; place-items: center; background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--accent-strong) 28%, transparent), var(--surface)); }
  @media (max-width: 62rem) { .split { grid-template-columns: 1fr; } .art { max-width: 22rem; } }
</style>
