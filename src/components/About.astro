---
import Placeholder from './Placeholder.astro';
import { site, training, education, languages } from '../data/site';
const facts = [
  { label: 'Location', value: site.location, ph: 'location' },
  { label: 'Training', value: 'training', ph: '' },
  { label: 'Education', value: 'education', ph: '' },
  { label: 'Languages', value: languages, ph: 'languages spoken' },
] as const;
---
<section id="about" class="section wrap" aria-labelledby="about-title">
  <h2 id="about-title" class="section-title">About</h2>
  <div class="grid">
    <div class="text">
      <p class="big">I am a software developer in {site.location}, building business software with Java, Spring Boot and Flutter. I hold a B.Sc. and an M.Sc. in Physics from the University of Rajshahi.</p>
      <p class="p">I completed the {training.programme} course in {training.course.replace(' using ', ' with ')} ({training.duration}), covering Java, Oracle, UML, Hibernate, Angular, Spring Boot, Android and Flutter. I apply that stack to software for the garment industry: RMGFlow, a Spring Boot and Flutter platform for buying houses, and Tanabana, an Angular and Spring Boot ERP for garment groups.</p>
    </div>
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>
            {f.value === 'training'
              ? <><a href="#experience">{training.programme}</a>, course completed ({training.track})</>
              : f.value === 'education'
                ? <ul class="edu">{education.map((e) => <li>{e.degree} ({e.year}), {e.school}</li>)}</ul>
                : (f.value ?? <Placeholder>{f.ph}</Placeholder>)}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem clamp(1rem, 3vw, 3rem); margin-top: clamp(2rem, 4vw, 3.5rem); }
  .text { grid-column: 1 / span 7; }
  .big { font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.5rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
  .p { margin-top: 1.6rem; color: var(--muted); max-width: 58ch; }
  .facts { grid-column: 9 / -1; align-self: start; border-top: 1px solid var(--line-strong); }
  .facts div { padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  dt { font-size: var(--step--1); color: var(--muted); }
  dd { margin-top: 0.15rem; font-weight: 500; }
  dd a { color: var(--text); text-decoration-color: var(--accent); }
  dd a:hover { color: var(--accent); }
  .edu li + li { margin-top: 0.3rem; }
  @media (max-width: 62rem) { .text, .facts { grid-column: 1 / -1; } }
</style>
